# 赛博老爸·求职系统 — 复制为 .env，填写后重启本地服务。
# 默认不配置任何外部服务即可使用示例、规则匹配与本地模板。
PORT=4318

# OpenAI-compatible Chat Completions endpoint. Specify a model supported by your provider.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Email providers may require an app-specific password and enabling SMTP/IMAP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# false blocks ALL real outbound mail. Review drafts before enabling real delivery.
ENABLE_OUTBOUND=false

# Optional path for local workspace state; default ./data
# DATA_DIR=
